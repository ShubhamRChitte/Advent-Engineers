{
  "name": "backend",
  "version": "1.0.6",
  "main": "main.js",
  "scripts": {
    "start": "node index.js",
    "start-desktop": "electron .",
    "build-exe": "electron-builder --win",
    "dev": "nodemon index.js",
    "test": "echo \"No tests yet\""
  },
  "build": {
    "appId": "com.adventengineers.admin",
    "productName": "Advent Testing Panel",
    "artifactName": "Advent-Testing-Panel-Setup-${version}.${ext}",
    "win": {
      "target": "nsis",
      "icon": "assets/advent_logo.ico"
    },
    "directories": {
      "output": "desktop-dist"
    },
    "files": [
      "**/*",
      ".env",
      "frontend-build/**/*"
    ],
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "ShubhamRChitte",
        "repo": "Advent-Engineers"
      }
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "axios": "^1.13.5",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.2.2",
    "cloudinary": "^1.41.3",
    "connect-mongo": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "express-async-handler": "^1.2.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.19.0",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.1.4",
    "multer": "^2.0.2",
    "multer-storage-cloudinary": "^4.0.0",
    "node-cron": "^4.2.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "passport-local-mongoose": "^9.0.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "nodemon": "^3.1.11"
  }
}
